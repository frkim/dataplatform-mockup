# Copy to .env and adjust. Every setting is optional; defaults are shown.
# No secrets are needed: the mockup has no external dependencies.

# Interface and port the HTTP server binds to (use 0.0.0.0 in containers).
DATAPLATFORM_HOST=127.0.0.1
DATAPLATFORM_PORT=8000

# Externally reachable URL, used in A2A agent cards and endpoint discovery.
DATAPLATFORM_PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed by CORS (wildcards are rejected).
DATAPLATFORM_CORS_ALLOWED_ORIGINS=http://localhost:3000

# MCP DNS-rebinding protection: allowed Host and Origin headers (":*" matches any port).
DATAPLATFORM_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
DATAPLATFORM_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# Query engine limits.
DATAPLATFORM_QUERY_TIMEOUT_SECONDS=10
DATAPLATFORM_QUERY_HISTORY_SIZE=500
DATAPLATFORM_ENGINE_MEMORY_LIMIT=1GB
DATAPLATFORM_ENGINE_THREADS=4

# Seed of the deterministic sample-data generator.
DATAPLATFORM_DATA_SEED=42

# DEBUG, INFO, WARNING or ERROR.
DATAPLATFORM_LOG_LEVEL=INFO
